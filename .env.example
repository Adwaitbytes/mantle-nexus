# ============================================
# MERIDIAN - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================

# Your wallet private key (WITHOUT 0x prefix)
# WARNING: Keep this secret! Never share or commit!
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Mantle Network RPC URLs
MANTLE_TESTNET_RPC=https://rpc.sepolia.mantle.xyz
MANTLE_MAINNET_RPC=https://rpc.mantle.xyz

# Mantlescan API Key (for contract verification)
# Get your API key from https://explorer.sepolia.mantle.xyz (testnet) or https://mantlescan.xyz (mainnet)
ETHERSCAN_API_KEY=your_mantlescan_api_key

# ============================================
# FRONTEND CONFIGURATION  
# ============================================

# Public RPC for frontend (safe to expose)
VITE_MANTLE_TESTNET_RPC=https://rpc.sepolia.mantle.xyz
VITE_MANTLE_MAINNET_RPC=https://rpc.mantle.xyz

# Chain IDs (Mantle Sepolia Testnet = 5003, Mainnet = 5000)
VITE_MANTLE_TESTNET_CHAIN_ID=5003
VITE_MANTLE_MAINNET_CHAIN_ID=5000

# ============================================
# DEPLOYED CONTRACT ADDRESSES
# ============================================
# Fill these after deploying contracts

VITE_MERIDIAN_TOKEN_ADDRESS=
VITE_MERIDIAN_VAULT_ADDRESS=
VITE_YIELD_AGGREGATOR_ADDRESS=
VITE_ZKKYC_VERIFIER_ADDRESS=
VITE_COMPLIANCE_REGISTRY_ADDRESS=

# ============================================
# ORACLE CONFIGURATION
# ============================================

# Pyth Network Oracle (Mantle supported)
VITE_PYTH_ORACLE_ADDRESS=0xA2aa501b19aff244D90cc15a4Cf739D2725B5729
